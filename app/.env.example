# Copy to .env.local
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Optional: another OpenAI-compatible endpoint (used by the local fake server in tests)
# OPENROUTER_BASE_URL=
NEXT_PUBLIC_PAYMENT_LINK=
# Junction sandbox key. One Link covers WHOOP, Garmin, Oura, Fitbit and Polar.
# JUNCTION_API_KEY=
# JUNCTION_WEBHOOK_SECRET=
# Signs staff session cookies. Optional: when empty, a key is derived from FIREBASE_SERVICE_ACCOUNT (hosted) or a fixed dev key (local).
# SESSION_SECRET=
# Staff sign in with signo. Add the app at https://usesigno.co.uk/account/sites as a site with a server, then paste its client ID
# and secret. signo sends people back to the address they started on, so its callback URLs must list each address staff use:
# https://<your-domain>/auth/callback, and http://localhost:3000/auth/callback (or the port you run on) for development.
SIGNO_CLIENT_ID=
SIGNO_CLIENT_SECRET=
# Optional: another signo, such as one running on this machine.
# SIGNO_ISSUER=http://localhost:4100
# Hosted only: Firebase service-account JSON on one line (Firebase console, Project settings, Service accounts).
# FIREBASE_SERVICE_ACCOUNT=
# Polar AccessLink (register a client at https://admin.polaraccesslink.com and add the callback URLs below).
# Callback URLs: http://localhost:3100/api/polar/callback and https://<your-domain>/api/polar/callback
# POLAR_CLIENT_ID=
# POLAR_CLIENT_SECRET=
# Optional overrides, used for local testing against a fake Polar:
# POLAR_AUTH_URL=
# POLAR_TOKEN_URL=
# POLAR_API_URL=
# POLAR_REDIRECT_URI=
# Email (Resend). Without a key, emails are only logged.
# RESEND_API_KEY=
# MAIL_FROM=RepReady <digest@your-domain>
# Public address of the app, used in email links. Defaults to the request's own origin.
# APP_URL=
# Secret the scheduler sends as "Authorization: Bearer <value>" to /api/cron/digest. The endpoint is closed without it.
# CRON_SECRET=
# Stripe signs its webhook calls; create an endpoint for https://<your-domain>/api/stripe/webhook (event checkout.session.completed) and paste its signing secret.
# STRIPE_WEBHOOK_SECRET=
# Club ids (from the staff page) let in without paying, comma separated: your own demo club, a free pilot.
# COMPED_CLUBS=
# Optional but recommended: lets the app confirm a payment itself when Stripe sends the buyer back (restricted key with read access to Checkout Sessions is enough).
# STRIPE_SECRET_KEY=
# Set to 1 once a sending domain is verified in Resend and MAIL_FROM uses it: the digest then goes only to confirmed addresses. Signing in with signo confirms an address.
# REQUIRE_EMAIL_CONFIRMATION=1
# Emails (comma separated) allowed to open /admin, the pilot health view across all clubs. Empty means nobody.
# PLATFORM_ADMIN_EMAILS=
