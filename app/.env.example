# Copy to .env.local
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-5.5
# Optional: another OpenAI-compatible endpoint (used by the local fake server in tests)
# OPENROUTER_BASE_URL=
NEXT_PUBLIC_PAYMENT_LINK=
# Junction sandbox key. One Link covers WHOOP, Garmin, Oura, Fitbit and Polar.
# JUNCTION_API_KEY=
# JUNCTION_WEBHOOK_SECRET=
# Signs staff session cookies. Optional: when empty, a key is derived from FIREBASE_SERVICE_ACCOUNT (hosted) or a fixed dev key (local).
# SESSION_SECRET=
# Hosted only: Firebase service-account JSON on one line (Firebase console, Project settings, Service accounts).
# FIREBASE_SERVICE_ACCOUNT=
# Polar AccessLink (register a client at https://admin.polaraccesslink.com and add the callback URLs below).
# Callback URLs: http://localhost:3100/api/polar/callback and https://<your-domain>/api/polar/callback
# POLAR_CLIENT_ID=
# POLAR_CLIENT_SECRET=
# Optional overrides, used for local testing against a fake Polar:
# POLAR_AUTH_URL=
# POLAR_TOKEN_URL=
# POLAR_API_URL=
# POLAR_REDIRECT_URI=
# Email (Resend). Without a key, emails are only logged.
# RESEND_API_KEY=
# MAIL_FROM=RepReady <digest@your-domain>
# Public address of the app, used in email links. Defaults to the request's own origin.
# APP_URL=
# Secret the scheduler sends as "Authorization: Bearer <value>" to /api/cron/digest. The endpoint is closed without it.
# CRON_SECRET=
